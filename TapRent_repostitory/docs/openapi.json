                  },
                  "rfid_uid": {
                    "type": "string"
                  },
                  "available_from": {
                    "type": "string"
                  },
                  "available_until": {
                    "type": "string"
                  },
                  "daily_rate": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "photo": {
                    "type": "string",
                    "description": "Opsional. Data URL JPEG, PNG atau WebP hingga 250 KiB."
                  }
                }
              }
            }
          }
        }
      }
