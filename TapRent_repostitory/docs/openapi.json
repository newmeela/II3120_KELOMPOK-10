        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "description",
                  "location",
                  "terms",
                  "rfid_uid",
                  "available_from",
                  "available_until",
                  "daily_rate"
                ],
                "properties": {
