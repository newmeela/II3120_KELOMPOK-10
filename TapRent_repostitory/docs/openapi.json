  "paths": {
    "/api/config": {
      "get": {
        "summary": "Konfigurasi simulator",
        "responses": {
          "200": {
            "description": "Berhasil",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Sesi tidak tersedia atau berakhir"
          }
        }
      }
    },
    "/api/items": {
