            "description": "Sesi tidak tersedia atau berakhir"
          }
        }
      }
    },
    "/api/items/search": {
      "get": {
        "summary": "Pencarian semantik dan kata kunci",
        "responses": {
          "200": {
            "description": "Berhasil",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Input tidak valid"
          },
          "401": {
            "description": "Sesi tidak tersedia atau berakhir"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "starts",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "ends",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "budget",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "description": "Filter penawaran aktif, jadwal, dan biaya, lalu urutkan dengan cosine similarity. Mode sentence_transformer, keyword_fallback, atau no_candidates."
      }
    },
    "/api/bookings": {
      "get": {
        "summary": "Daftar reservasi demo",
        "responses": {
          "200": {
            "description": "Berhasil",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Sesi tidak tersedia atau berakhir"
          }
        }
      },
      "post": {
        "summary": "Ajukan reservasi sebagai Penyewa",
        "responses": {
          "201": {
            "description": "Berhasil",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Input tidak valid"
          },
          "404": {
            "description": "Barang tidak ditemukan"
          },
          "409": {
            "description": "SCHEDULE_CONFLICT"
          },
          "401": {
            "description": "Sesi tidak tersedia atau berakhir"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "item_id",
                  "starts",
                  "ends",
                  "accept_terms"
                ],
                "properties": {
                  "item_id": {
                    "type": "integer"
                  },
                  "starts": {
                    "type": "string",
                    "format": "date"
                  },
                  "ends": {
                    "type": "string",
                    "format": "date"
                  },
                  "accept_terms": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "expected_terms": {
                    "type": "string",
                    "description": "Ketentuan yang dilihat penyewa. Perubahan isi menghasilkan HTTP 409."
                  }
                }
              }
            }
          }
        }
      }
    },
