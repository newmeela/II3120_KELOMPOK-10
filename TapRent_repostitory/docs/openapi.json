    "/api/offers": {
      "get": {
        "summary": "Penawaran milik akun Pemilik",
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "400": {
            "description": "Input tidak valid"
          },
          "401": {
            "description": "Sesi dibutuhkan"
          },
          "403": {
            "description": "Aksi memerlukan peran Pemilik"
          },
          "409": {
            "description": "UID duplikat atau data dikunci transaksi aktif"
          }
        }
      },
      "post": {
        "summary": "Terbitkan penawaran",
        "responses": {
          "201": {
            "description": "Berhasil"
          },
          "400": {
            "description": "Input tidak valid"
